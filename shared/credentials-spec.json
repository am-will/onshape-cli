{
  "version": 1,
  "defaultBaseUrl": "https://cad.onshape.com",
  "service": "onshape-cli",
  "keychain": {
    "service": "onshape-cli",
    "account": "base_url hostname, for example cad.onshape.com",
    "value": {
      "type": "json",
      "required": ["access_key", "secret_key", "base_url"]
    }
  },
  "files": {
    "primary": "~/.onshape/credentials.json",
    "overrideEnv": "ONSHAPE_CONFIG",
    "linuxXdgReadFallback": "$XDG_CONFIG_HOME/onshape/credentials.json",
    "mode": "0600 where supported"
  },
  "fileSchemas": {
    "file": {
      "backend": "file",
      "required": ["access_key", "secret_key"],
      "optional": ["base_url"]
    },
    "keychain": {
      "backend": "keychain",
      "required": ["access_key"],
      "forbidden": ["secret_key"],
      "optional": ["base_url", "account"]
    },
    "legacy": {
      "backend": "absent",
      "required": ["access_key", "secret_key"],
      "optional": ["base_url"]
    }
  },
  "resolutionOrder": [
    "explicit flags",
    "ONSHAPE_ACCESS_KEY / ONSHAPE_SECRET_KEY environment variables",
    "primary credentials file or ONSHAPE_CONFIG override",
    "Linux XDG credentials file fallback",
    "~/.claude/mcp.json mcpServers.onshape.env"
  ],
  "baseUrlOrder": [
    "explicit --base-url flag",
    "ONSHAPE_BASE_URL environment variable",
    "resolved credential source base_url",
    "https://cad.onshape.com"
  ],
  "storeModes": {
    "auto": "try keychain first and fall back to file storage if unavailable",
    "keychain": "require keychain storage; do not silently persist the secret to a file",
    "file": "persist access_key, secret_key, and base_url inline"
  },
  "redaction": {
    "secret": "show first 3 and last 3 characters when length is greater than 8, otherwise ***"
  }
}
